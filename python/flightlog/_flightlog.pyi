from typing import Any, Dict, List, Optional, Sequence, Tuple, Union
import os

import pyarrow

__version__: str
FACTS_VERSION: str

class Log:
    def __init__(
        self,
        source: Union[str, "os.PathLike[str]", bytes, bytearray, memoryview],
        types: Optional[Sequence[str]] = None,
        scale: bool = True,
        keep_order: bool = False,
    ) -> None: ...
    @property
    def kind(self) -> str: ...
    @property
    def path(self) -> Optional[str]: ...
    @property
    def message_types(self) -> List[str]: ...
    @property
    def counts(self) -> Dict[str, int]: ...
    @property
    def params(self) -> Dict[str, float]: ...
    @property
    def integrity(self) -> Dict[str, Any]: ...
    @property
    def utc_offset_us(self) -> Optional[int]: ...
    @property
    def time_range_us(self) -> Optional[Tuple[int, int]]: ...
    @property
    def time_column(self) -> str: ...
    def instance_field(self, name: str) -> Optional[str]: ...
    def columns(self, name: str) -> List[Tuple[str, str, Optional[str]]]: ...
    def table(self, name: str, instance: Optional[int] = None) -> pyarrow.Table: ...
    def order(self) -> Optional[pyarrow.Table]: ...
    def facts_json(self, vibe_percentile: float = 0.95, events: bool = True) -> str: ...
    def __len__(self) -> int: ...
    def __contains__(self, name: str) -> bool: ...

def detect(data: bytes) -> Optional[str]: ...
def facts_schema() -> str: ...
